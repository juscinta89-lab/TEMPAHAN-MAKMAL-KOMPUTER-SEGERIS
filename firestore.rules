rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================
    // BOOKINGS COLLECTION
    // Semua orang boleh baca (untuk papar slot)
    // Semua orang boleh tulis (guru log masuk via app)
    // =========================================================
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nama_guru', 'tarikh', 'slot', 'status'])
                    && request.resource.data.nama_guru is string
                    && request.resource.data.nama_guru.size() > 0;
      allow delete: if true;
      allow update: if false; // Tidak benarkan update, hanya delete + create
    }
    
    // =========================================================
    // TEACHERS COLLECTION
    // Semua orang boleh baca (untuk login check)
    // Semua orang boleh daftar
    // Hanya admin boleh delete (implementasi via app logic)
    // =========================================================
    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nama_guru', 'password'])
                    && request.resource.data.nama_guru is string
                    && request.resource.data.nama_guru.size() > 0
                    && request.resource.data.password is string
                    && request.resource.data.password.size() >= 6;
      allow delete: if true;
      allow update: if false;
    }
  }
}
